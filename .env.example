# ─────────────────────────────────────────────────────────────
# CLIENTE (navegador) — deben llevar prefijo VITE_
# ─────────────────────────────────────────────────────────────
# Conversión de Google Ads (formato AW-XXXXXXXXX/YYYYYYYYYYY)
VITE_GTAG_CONVERSION_ID=AW-XXXXXXXXX/YYYYYYYYYYY

# ─────────────────────────────────────────────────────────────
# SERVIDOR (función /api/lead/submit) — SIN prefijo VITE_
# Nunca llegan al navegador.
# ─────────────────────────────────────────────────────────────
# EmailJS (envío server-side vía API REST)
EMAILJS_SERVICE_ID=service_XXXXXXX
EMAILJS_TEMPLATE_ID=template_XXXXXXX
EMAILJS_PUBLIC_KEY=XXXXXXXXXXXXXXXX
EMAILJS_PRIVATE_KEY=XXXXXXXXXXXXXXXX
